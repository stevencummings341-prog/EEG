# ===== raw data: NEVER in this repo (external, path from configs/paths.yaml) =====
/data/

# ===== run artifacts & processed data (processed_* lives under outputs/) =====
/outputs/*
/logs/*
/checkpoints/*
!/outputs/.gitkeep
!/logs/.gitkeep
!/checkpoints/.gitkeep
wandb/
runs/
slog/

# ===== local archive (large; keep on disk, do not push) =====
/backup/*

# ===== generated manifests & splits (contain absolute server paths) =====
/manifests/*.csv
/manifests/*.json
/splits/*.json

# keep the directory structure (re-include placeholder files)
!**/.gitkeep

# ===== python =====
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== env =====
.env
.venv/
env/
venv/

# ===== large / binary data files (anywhere) =====
*.bdf
*.edf
*.mat
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.h5
*.hdf5
*.rar
*.zip
*.tar
*.tar.gz
*.7z
*.pdf
*.pptx
*.ppt

# ===== editor / OS / IDE local =====
.DS_Store
*.swp
.idea/
*.local.yaml
*.local.yml

# ===== slurm / job noise =====
*.out
*.err
